# Server-only target for Vite development/preview API proxy. Restart after changing.
# Public landing login is always /login. Legacy VITE_LEARNER_PORTAL_URL is ignored.
# A production deployment must route /api/v1 to its backend separately.
PORTAL_API_TARGET=http://127.0.0.1:4003
# Vercel build-time public backend origin. Optional before Railway is connected.
# Without it, public pages work but API/login/learning data are unavailable.
# Set on Vercel (not VITE_); see docs/DEPLOY-VERCEL-RAILWAY.md.
# PORTAL_API_ORIGIN=https://your-api.up.railway.app
# API process variables are supplied by the shell (never VITE_).
# PORTAL_API_PORT=4003
# PORTAL_API_HOST=127.0.0.1
# Railway/container: PORTAL_API_HOST=0.0.0.0, attach volume /data,
# PORTAL_DB_PATH=/data/portal.sqlite and set the exact HTTPS PORTAL_WEB_ORIGIN.
# Railway PORT is used when PORTAL_API_PORT is unset.
# PORTAL_DB_PATH=.local/portal/portal.sqlite
# PORTAL_WEB_ORIGIN=https://your-confirmed-host.example

# Submission file storage is opt-in; existing local files and materials stay local.
# Default: sqlite. Preparation only: no centre Drive folder or credentials configured.
# PORTAL_SUBMISSION_STORAGE=sqlite
# Enable only after completing docs/GOOGLE-DRIVE-STORAGE.md with a private test folder.
# PORTAL_SUBMISSION_STORAGE=google-drive
# PORTAL_DRIVE_FOLDER_ID=REPLACE_WITH_PRIVATE_FOLDER_ID
# PORTAL_DRIVE_AUTH_MODE=service-account
# PORTAL_DRIVE_CREDENTIALS_FILE=.local/portal/google-drive-service-account.json
# Required for service-account; optional for oauth when targeting a Shared Drive.
# PORTAL_DRIVE_SHARED_DRIVE_ID=REPLACE_WITH_SHARED_DRIVE_ID
# Alternative for a centre-owned My Drive user: PORTAL_DRIVE_AUTH_MODE=oauth
# PORTAL_DRIVE_CREDENTIALS_FILE=.local/portal/google-drive-oauth.json
# Credentials JSON stays private/ignored. Never use VITE_ for any Drive setting.
# The API does not automatically load this file: use process environment or
# node --env-file=.local/portal/drive.env --experimental-strip-types server/index.ts

# Admin Google sign-in and My Drive folder browser (Settings).
# Configure a Google Cloud Web application OAuth client with Drive API enabled.
# Secrets belong only in ignored .local/portal/google.env. Never use VITE_.
# PORTAL_GOOGLE_CLIENT_ID=REPLACE.apps.googleusercontent.com
# PORTAL_GOOGLE_CLIENT_SECRET=REPLACE_PRIVATELY
# Match the exact portal origin used in the browser and Google authorized redirect URI.
# PORTAL_GOOGLE_REDIRECT_URI=http://127.0.0.1:5173/api/v1/portal/drive/callback
# pnpm server:local loads speaking.env, google.env, email.env, then gemini.env.
# OAuth refresh tokens are encrypted in SQLite; back up the adjacent private
# drive-oauth.key together with the database. Never commit either.

# Transactional email preparation: disabled by default; no provider configured.
# Server-only settings; see docs/EMAIL-DELIVERY.md before enabling a staging send.
# PORTAL_EMAIL_ENABLED=false
# PORTAL_EMAIL_PROVIDER=disabled
# Optional prepared adapter: PORTAL_EMAIL_PROVIDER=resend
# PORTAL_EMAIL_API_KEY=REPLACE_IN_PRIVATE_SERVER_ENV_ONLY
# PORTAL_EMAIL_FROM=teaching@your-confirmed-domain.example
# Enabled email requires the actual HTTPS website origin, without a path.
# PORTAL_EMAIL_PORTAL_ORIGIN=https://your-confirmed-host.example
# Installation-wide template language until per-account language is implemented.
# PORTAL_EMAIL_LOCALE=vi
# PORTAL_EMAIL_TIME_ZONE=Asia/Ho_Chi_Minh
# Technical defaults, subject to the confirmed reminder policy (integers 1-168).
# PORTAL_EMAIL_ASSIGNMENT_LEAD_HOURS=24
# PORTAL_EMAIL_LESSON_LEAD_HOURS=1
# Private ignored example: node --env-file=.local/portal/email.env --experimental-strip-types server/index.ts

# Speaking AI: disabled until a private server key and explicit enablement exist.
# Never use VITE_ for these values. See docs/SPEAKING-AI.md.
# The selected local provider is Gemini; keep its key in .local/portal/gemini.env.
# PORTAL_AI_PROVIDER=gemini
# PORTAL_AI_ENABLED=false
# Optional fixed UTC cutoff, checked before each provider call even after restart.
# Do not extend the currently authorized local trial without approval.
# PORTAL_AI_EXPIRES_AT=2026-10-12T12:15:41.633Z
# PORTAL_GEMINI_API_KEY=REPLACE_IN_PRIVATE_SERVER_ENV_ONLY
# PORTAL_GEMINI_SPEECH_MODEL=gemini-3.8-flash-tts
# PORTAL_GEMINI_TRANSCRIBE_MODEL=gemini-3.8-flash
# PORTAL_GEMINI_ASSESSMENT_MODEL=gemini-3.8-flash
# PORTAL_GEMINI_VOICE=Kore
# Legacy OpenAI settings are used only when PORTAL_AI_PROVIDER=openai (the
# compatibility default if omitted). Gemini never falls back to this key.
# PORTAL_AI_API_KEY=REPLACE_IN_PRIVATE_SERVER_ENV_ONLY
# PORTAL_AI_SPEECH_MODEL=gpt-4o-mini-tts
# PORTAL_AI_TRANSCRIBE_MODEL=gpt-transcribe
# PORTAL_AI_ASSESSMENT_MODEL=gpt-audio-1.5
# PORTAL_AI_VOICE=coral
# Rolling 24-hour job caps, including failed/cancelled requests; not dollar budgets.
# PORTAL_AI_DAILY_JOBS=20
# PORTAL_AI_DAILY_GLOBAL_JOBS=100
# pnpm server:ai loads speaking.env, then gemini.env. Restart after editing.
