{
  "name": "project-l",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "server:dev": "node --watch --experimental-strip-types server/index.ts",
    "server": "node --experimental-strip-types server/index.ts",
    "server:ai": "node --env-file-if-exists=.local/portal/speaking.env --env-file-if-exists=.local/portal/gemini.env --experimental-strip-types server/index.ts",
    "server:local": "node --env-file-if-exists=.local/portal/speaking.env --env-file-if-exists=.local/portal/google.env --env-file-if-exists=.local/portal/email.env --env-file-if-exists=.local/portal/gemini.env --experimental-strip-types server/index.ts",
    "admin:bootstrap": "node --experimental-strip-types server/bootstrap.ts",
    "typecheck": "tsc -b",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:portal": "node --experimental-strip-types --test tests/*.test.ts",
    "test:server": "node --experimental-strip-types --test server/*.test.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build",
    "release:package": "node scripts/package-release.mjs"
  },
  "dependencies": {
    "@fontsource/be-vietnam-pro": "5.3.0",
    "@phosphor-icons/react": "2.1.10",
    "google-auth-library": "11.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.7",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "8.3.3"
  },
  "packageManager": "pnpm@11.25.0"
}
